# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - BOT-BIP
# Copia este archivo como .env y completa tus credenciales.
# ==============================================================================

# ------------------------------------------------------------------------------
# TELEGRAM BOT AGENT
# ------------------------------------------------------------------------------
# Token provisto por @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui

# ------------------------------------------------------------------------------
# DATABASE & SECURITY AGENT (SUPABASE)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave Anónima Pública (Usada para clientes de lectura/Dashboard Streamlit)
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Clave Service Role Secreta (Usada para operaciones del Bot Backend con privilegios elevados)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# ------------------------------------------------------------------------------
# DASHBOARD CONFIGURATION (OPCIONAL)
# ------------------------------------------------------------------------------
PORT=8501
DASHBOARD_URL=http://localhost:8501

# ------------------------------------------------------------------------------
# AI INSIGHTS AGENT (LLM GRATUITO)
# ------------------------------------------------------------------------------
# Groq API Key (Recomendado 100% Gratis: https://console.groq.com/)
GROQ_API_KEY=gsk_tu_groq_api_key_aqui
